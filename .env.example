# JALDRISHTI AI — Environment Configuration
# Default mode is SIMULATION (runs 100% offline without requiring external API keys)

APP_ENV=development
PORT=8000
HOST=127.0.0.1
PILOT_BASIN_CONFIG=basin_config.yaml
SIMULATION_MODE=true

# Authentication & Security Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_sec_2026
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change_this_operator_password_sec_2026
CITIZEN_AUTH_SECRET_KEY=change_this_citizen_auth_secret_key_2026_32bytes

# Map Provider Runtime Configuration
# Supported providers: osm (OpenStreetMap Public), carto (CARTO Dark Matter), maptiler, mapbox, offline
VITE_MAP_PROVIDER=osm
VITE_MAP_STYLE_URL=
# VITE_MAP_API_KEY is required ONLY if using MapTiler or Mapbox (public client token)
VITE_MAP_API_KEY=

# Optional External Data Provider Integration Credentials
# (When left blank, adapters automatically operate in verified fallback mode)
IMD_API_KEY=
MOSDAC_API_KEY=
NASA_EARTHDATA_TOKEN=
ECMWF_OPEN_DATA_ENABLED=false
CWC_WRIS_TOKEN=
WORLDPOP_API_KEY=
